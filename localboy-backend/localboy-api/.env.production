# ==================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ==================================================
# DO NOT check this into version control
# Use Docker secrets, Kubernetes secrets, or CI/CD variables instead

# Database
DATABASE_HOST=prod-db-host
DATABASE_PORT=5432
DATABASE_USER=localboy_prod
DATABASE_PASSWORD=${DB_PASSWORD}
DATABASE_NAME=localboy_prod

# Server
PORT=3000
NODE_ENV=production

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=${JWT_SECRET}

# Twilio SMS
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_MESSAGING_SERVICE_SID=${TWILIO_MESSAGING_SERVICE_SID}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}

# Email SMTP
EMAIL_USER=${EMAIL_USER}
EMAIL_APP_PASS=${EMAIL_APP_PASS}

# Razorpay (LIVE keys in production)
RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID_PROD}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET_PROD}

# Google
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# Gemini AI
GEMINI_API_KEY=${GEMINI_API_KEY}

# CORS - restrict to your domain only
CORS_ORIGIN=https://localboy.com,https://admin.localboy.com,https://api.localboy.com
